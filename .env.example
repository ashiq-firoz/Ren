# ─── Ren by f69 Labs — docker compose configuration ───────────────────────────
# cp .env.example .env && docker compose up -d --build

# Public address.
#   Local machine (default): plain HTTP at http://localhost — DOMAIN=:80, PUBLIC_URL=http://localhost
#   Server with a real domain: DOMAIN=ren.example.com, PUBLIC_URL=https://ren.example.com
#   (point DNS at the server first; Caddy obtains TLS certificates automatically).
DOMAIN=:80
PUBLIC_URL=http://localhost

# Required secrets — generate each with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
SANDBOX_TOKEN=
POSTGRES_PASSWORD=ren

# Model provider bootstrapped into new workspaces (more can be added in Settings → Models)
# Google AI Studio (aistudio.google.com/apikey); model ids have no google/ prefix or :free suffix
GOOGLE_AI_STUDIO_KEY=
GOOGLE_AI_STUDIO_MODEL=gemma-4-26b-a4b-it
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=

# Retrieval
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_PROVIDER=fastembed

# Alignment checker (Laya). LAYA_DEVICE=cuda with docker-compose.gpu.yml
LAYA_API_KEY=
LAYA_DEVICE=cpu

# Web search: duckduckgo needs no key
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=

MAX_CONCURRENT_TASKS=6
SANDBOX_MEMORY=2g
