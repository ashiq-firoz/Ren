# ─── Ren by f69 Labs — backend configuration ───────────────────────────────────
# Copy to backend/.env and fill in what you need. Everything has a sensible default.

# ── LLM provider bootstrapped into new workspaces (you can also add providers in the UI) ──
# OpenRouter (single API for hundreds of models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
# …or a self-hosted vLLM (OpenAI-compatible). Start vLLM with tool calling enabled, e.g.:
#   vllm serve Qwen/Qwen3-32B --enable-auto-tool-choice --tool-call-parser hermes
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=

# ── Security ──
# SECRET_KEY signs sessions and encrypts stored credentials. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Storage ──
# Default: SQLite under backend/data (zero-ops, single user). Production: PostgreSQL + pgvector.
# DATABASE_URL=postgresql+asyncpg://ren:ren@localhost:5432/ren
DATABASE_URL=
# REDIS_URL=redis://localhost:6379/0      # optional: event fan-out across API replicas
REDIS_URL=
DATA_DIR=

# ── Retrieval (STAIR hybrid RAG) ──
EMBEDDING_PROVIDER=fastembed          # fastembed (local ONNX) | openai (any OpenAI-compatible /embeddings) | hash (tests)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384                     # must match the model; changing it requires a fresh database
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RERANKER_PROVIDER=fastembed           # fastembed (cross-encoder) | llm | none
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ── Alignment checker: Laya (convaiinnovations/laya) ──
# Run `laya-serve` (see services/laya) and point Ren at it. Without it, an LLM judge is used.
LAYA_URL=
LAYA_API_KEY=
LAYA_MODEL=auto                       # auto | english | multilingual | typed-decisions
LAYA_LOCAL=false                      # load Laya in-process (pip install laya; pulls torch)

# ── Execution sandbox for shell/code tools ──
# Unset = run on this host inside the per-user workspace (dev). Docker deployments use the sandbox service.
SANDBOX_URL=
SANDBOX_TOKEN=
ALLOW_PRIVATE_NETWORK=false           # let web/browser tools reach localhost/private IPs

# ── Web search ──
WEB_SEARCH_PROVIDER=duckduckgo        # duckduckgo (no key) | tavily | brave | searxng
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=

# ── Runtime ──
MAX_CONCURRENT_TASKS=6
LOG_LEVEL=INFO
